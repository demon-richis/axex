# Discord bot token from the Developer Portal
BOT_TOKEN=your_bot_token_here
# Discord application/client ID
CLIENT_ID=your_bot_client_id_here
# Neon Postgres connection string
DATABASE_URL=your_neondb_connection_string_here
# Verification portal configuration
WEBSITE_URL=https://your-portal.vercel.app
# Bot-to-portal API key; match BOT_TO_PORTAL_KEY in the portal.
BOT_TO_PORTAL_KEY=replace_with_unique_32_plus_character_key
# Portal-to-bot webhook key; match PORTAL_TO_BOT_KEY in the portal.
PORTAL_TO_BOT_KEY=replace_with_a_different_unique_32_plus_character_key
# Legacy single-key compatibility fallback; keep only while rotating keys.
AXEX_BOT_API_KEY=
WEBHOOK_PORT=3001
INTELLIGENCE_URL=
INTELLIGENCE_API_KEY=
