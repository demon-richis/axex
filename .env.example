# Discord bot token from the Developer Portal
BOT_TOKEN=your_bot_token_here
# Discord application/client ID
CLIENT_ID=your_bot_client_id_here
# Neon Postgres connection string
DATABASE_URL=your_neondb_connection_string_here
# Verification portal configuration
WEBSITE_URL=https://your-portal.vercel.app
# Shared secret accepted by the portal webhook. Keep this identical to
# AXEX_BOT_API_KEY in axex-guardian-portal/.env.
WEBSITE_API_KEY=your_shared_secret_here
# Preferred explicit alias; either variable is accepted for compatibility.
AXEX_BOT_API_KEY=your_shared_secret_here
WEBHOOK_PORT=3001
INTELLIGENCE_URL=
INTELLIGENCE_API_KEY=
